{
  "name": "voxeli",
  "private": true,
  "version": "0.1.0",
  "description": "Voxeli \u2014 real-time AI voice translator platform (monorepo)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @voxeli/api db:generate",
    "db:migrate": "pnpm --filter @voxeli/api db:migrate",
    "db:seed": "pnpm --filter @voxeli/api db:seed",
    "mobile:run": "cd apps/mobile && flutter run",
    "mobile:test": "cd apps/mobile && flutter test",
    "mobile:analyze": "cd apps/mobile && flutter analyze"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild"
    ],
    "overrides": {
      "esbuild@<0.25.0": ">=0.25.0"
    }
  },
  "type": "module"
}
