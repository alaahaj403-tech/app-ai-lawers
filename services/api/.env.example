# ---- Voxeli API (services/api) ----
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgres://voxeli:voxeli@localhost:5432/voxeli
# Optional. Enables distributed rate limiting.
REDIS_URL=redis://localhost:6379

# 32+ random bytes. Generate: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
# Set during rotation so tokens signed with the previous key still verify.
# JWT_PREVIOUS_SECRET=
JWT_ISSUER=voxeli
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Server-side only. Never ship to mobile or browser bundles.
# OPENAI_API_KEY=
# Force provider selection: openai | mock (mock is refused in production)
# AI_PROVIDER=

# Model slot overrides (provider optional): VOXELI_MODEL_<SLOT>=provider:model
# VOXELI_MODEL_TRANSLATION_DEFAULT=openai:gpt-5.6-terra
# VOXELI_MODEL_REALTIME_TRANSLATION=openai:gpt-realtime-translate

# Public URL of the web app, used in verification / reset links (https in production)
APP_BASE_URL=http://localhost:3000
# console (dev/test only — refused in production) | resend
EMAIL_PROVIDER=console
# RESEND_API_KEY=
# EMAIL_FROM="Voxeli <no-reply@voxeli.app>"

CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=120
# Tighter budget for login/register/refresh (credential-stuffing surface)
AUTH_RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
